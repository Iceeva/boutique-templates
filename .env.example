# Postgres (Neon, Supabase, Vercel Postgres…) — utilise l'URL "pooled" sur Vercel
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Mot de passe de l'espace /admin
ADMIN_PASSWORD="change-moi"
# Chaîne aléatoire longue (ex: openssl rand -hex 32) pour signer la session
SESSION_SECRET="change-moi-aussi"
